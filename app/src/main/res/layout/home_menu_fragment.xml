<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="org.linphone.ui.home.viewModel.HomeViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/home_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#303030"
        tools:context=".ui.home.fragment.HomeMenuFragment">

        <ScrollView
            android:id="@+id/home_menu_root"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/home_bottom_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp">

                <!-- Top Logo Bar -->
                <LinearLayout
                    android:id="@+id/top_logo_bar"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_home_top_bar"
                    android:backgroundTint="?color_grey_500"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/logo"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart"
                        android:src="@drawable/logo" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/menu_more"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:onClick="@{() -> viewModel.navigateToMore()}"
                        android:padding="5dp"
                        android:src="@drawable/dots_three_vertical"
                        android:tint="@color/bc_white"
                        tools:ignore="UseAppTint" />

                </LinearLayout>

                <!-- Friend Connections -->
                <TextView
                    style="@style/HomeSectionTitle"
                    android:text="Friend Connections" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/menu_friends"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToFriends()}"
                            android:text="Friends" />

                        <TextView
                            android:id="@+id/menu_groups"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToGroups()}"
                            android:text="Groups" />

                    </LinearLayout>

                </HorizontalScrollView>

                <!-- One 2 One Caller -->
                <TextView
                    style="@style/HomeSectionTitle"
                    android:text="One 2 One Caller" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/menu_chat"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToChat()}"
                            android:text="Chat" />

                        <TextView
                            android:id="@+id/menu_phone"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToPhone()}"
                            android:text="Phone" />

                        <TextView
                            android:id="@+id/menu_video_call"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToVideoCall()}"
                            android:text="Video call" />

                    </LinearLayout>

                </HorizontalScrollView>

                <!-- Group Conferencing -->
                <TextView
                    style="@style/HomeSectionTitle"
                    android:text="Group Conferencing" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/menu_group_chat"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToGroupChat()}"
                            android:text="Group Chat" />

                        <TextView
                            android:id="@+id/menu_audio_meeting"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToAudioMeeting()}"
                            android:text="Audio Meeting" />

                        <TextView
                            android:id="@+id/menu_video_meeting"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToVideoMeeting()}"
                            android:text="Video Meeting" />

                    </LinearLayout>

                </HorizontalScrollView>

                <!-- Social Community -->
                <TextView
                    style="@style/HomeSectionTitle"
                    android:text="Social Community" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/menu_billboard"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToBillboard()}"
                            android:text="Billboard" />

                        <TextView
                            android:id="@+id/menu_broadcast"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToBroadcast()}"
                            android:text="Broadcast" />

                    </LinearLayout>

                </HorizontalScrollView>

                <!-- Utilities -->
                <TextView
                    style="@style/HomeSectionTitle"
                    android:text="Utilities" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/menu_ai"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToArtificialIntelligence()}"
                            android:text="Artificial&#10;Intelligence" />

                        <TextView
                            android:id="@+id/menu_calendar"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToCalendar()}"
                            android:text="Calendar" />

                        <TextView
                            android:id="@+id/menu_notes"
                            style="@style/HomeMenuTileHorizontal"
                            android:onClick="@{() -> viewModel.navigateToNotes()}"
                            android:text="Notes" />

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

        </ScrollView>

        <!-- Locked Bottom Bar -->
        <LinearLayout
            android:id="@+id/home_bottom_bar"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_home_bottom_bar"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/bottom_home"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="Home"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="|"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/bottom_invite"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:onClick="@{() -> viewModel.navigateToInvite()}"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="Invite"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>